// ═══════════════════════════════════════════════════════════════════════
var SUFFIX = {};
(function () {
    var i;
    for (i = 0; i < GAME.length; i++) SUFFIX[GAME[i]] = 1;
    if (CFG.INCLUDE_CDN) for (i = 0; i < CDN.length; i++) SUFFIX[CDN[i]] = 1;
})();

function isGame(h) {
    if (SUFFIX[h] === 1) return true;
    var i = h.indexOf(".");
    while (i !== -1) {
        if (SUFFIX[h.substring(i + 1)] === 1) return true;
        i = h.indexOf(".", i + 1);
    }
    return false;
}

function mkCache(max) {
    return {
        d: {}, q: [], max: max,
        get: function (k) {
            var e = this.d[k];
            if (e && (Date.now() - e.t) < e.ttl) return e.v;
            if (e) delete this.d[k];
            return undefined;
        },
        set: function (k, v, ttl) {
            if (this.q.length >= this.max) {
                var o = this.q.shift();
                if (o !== undefined) delete this.d[o];
            }
            this.d[k] = { v: v, t: Date.now(), ttl: ttl };
            this.q.push(k);
        }
    };
}
var routeCache = mkCache(CFG.MAX_CACHE);

function ip2int(ip) {
    var p = ip.split("."), n = 0, i, o;
    if (p.length !== 4) return -1;
    for (i = 0; i < 4; i++) {
        o = parseInt(p[i], 10);
        if (isNaN(o) || o < 0 || o > 255) return -1;
        n = n * 256 + o;
    }
    return n;
}

function isJordan(ip) {
    var n = ip2int(ip);
    if (n < 0) return false;
    var lo = 0, hi = JO.length - 1, mid;
    while (lo <= hi) {
        mid = (lo + hi) >> 1;
        if (n < JO[mid][0])      hi = mid - 1;
        else if (n > JO[mid][1]) lo = mid + 1;
        else return true;
    }
    return false;
}

function chain() {
    if (!CFG.ENABLE_PROXY || PROXIES.length === 0) return "DIRECT";
    var t = [[], [], []], i, x;
    for (i = 0; i < PROXIES.length; i++) {
        x = PROXIES[i].tier;
        t[(x >= 1 && x <= 3) ? x - 1 : 2].push(PROXIES[i].s);
    }
    return t[0].concat(t[1], t[2]).join("; ") + "; DIRECT";
}

// ═══════════════════════════════════════════════════════════════════════
function FindProxyForURL(url, host) {
    try {
        if (!host) return "DIRECT";
        var h = host.toLowerCase();

        var isTLS = (url.substring(0, 6) === "https:");

        // ⚠️ HTTPS ⟵ مباشر: لا بروكسي في القائمة يدعمه (مُختبَر فعلياً)
        if (CFG.HTTPS_DIRECT && isTLS) return "DIRECT";

        var c = routeCache.get(h);
        if (c !== undefined) return c;

        // شبكات محلية وخاصة ⟵ مباشر
        if (isPlainHostName(h) || h === "localhost" ||
            shExpMatch(h, "*.local") ||
            isInNet(h, "10.0.0.0",    "255.0.0.0")   ||
            isInNet(h, "172.16.0.0",  "255.240.0.0") ||
            isInNet(h, "192.168.0.0", "255.255.0.0") ||
            isInNet(h, "169.254.0.0", "255.255.0.0") ||
            isInNet(h, "127.0.0.0",   "255.0.0.0")) {
            return "DIRECT";
        }

        // ليست اللعبة ⟵ مباشر (split tunnel)
        if (!isGame(h)) {
            routeCache.set(h, "DIRECT", CFG.ROUTE_CACHE_TTL);
            return "DIRECT";
        }

        // وجهة أردنية ⟵ مباشر (البروكسي في هونغ كونغ سيضرّ)
        var ip = dnsResolve(h);
        if (ip && isJordan(ip)) {
            routeCache.set(h, "DIRECT", CFG.ROUTE_CACHE_TTL);
            return "DIRECT";
        }

        var out = chain();
        routeCache.set(h, out, CFG.ROUTE_CACHE_TTL);
        return out;

    } catch (e) {
        return "DIRECT";
    }
}
