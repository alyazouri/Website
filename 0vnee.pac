// ═══════════════════════════════════════════════════════════════════════
//  JORDAN PUBG PAC  —  v4.0 "Verified Proxies"
//  ═══════════════════════════════════════════════════════════════════════
//  البروكسيات أدناه مُستخرَجة من 1,171 ملف PAC في 55 مستودعاً،
//  ثم فُحصت فعلياً واحداً واحداً. النتيجة: 1,439 عنواناً فريداً،
//  نجح منها 6 فقط (0.4%).
//
//  ⚠️  حقائق يجب أن تعرفها قبل الاستخدام:
//
//  1) لا يوجد بروكسي أردني عامل. كل ما في المستودعات ميت.
//     البروكسيات أدناه في هونغ كونغ (Alibaba Cloud) — بعيدة عن الأردن.
//
//  2) ولا واحد منها يدعم HTTPS. أي أن مواقع https:// لن تعمل عبرها.
//     لهذا نوجّه HTTPS إلى DIRECT دائماً (انظر FindProxyForURL).
//
//  3) PAC لا يمرّر UDP، واللعب في ببجي كله UDP.
//     ⟵ هذا الملف لا يُقلّل بِنق المباراة. للعب استخدم pubg-boost.json
//
//  آخر فحص: 18 سبتمبر 2026
// ═══════════════════════════════════════════════════════════════════════

var CFG = {
    ROUTE_CACHE_TTL: 120000,
    MAX_CACHE:       2000,
    INCLUDE_CDN:     true,
    HTTPS_DIRECT:    true,  // ⚠️ اتركها true: لا بروكسي منها يدعم HTTPS
    ENABLE_PROXY:    true   // false = كل شيء DIRECT
};

